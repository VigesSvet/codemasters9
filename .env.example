DB_PATH=backend/data/archive.db
WEB_DIR=web
FILES_DIR=backend/data/files
AI_PROVIDER=local
SESSION_TTL_MIN=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=10
LOGIN_IP_MAX_ATTEMPTS=30
COOKIE_SECURE=false
API_DOCS=false
# адрес reverse proxy, которому uvicorn верит в X-Forwarded-For (без прокси - только loopback)
FORWARDED_ALLOW_IPS=127.0.0.1
# демо-пароль стенда; на проде задать свой - иначе seed печатает предупреждение, а админка показывает баннер
SEED_PASSWORD=Demo-2026!
